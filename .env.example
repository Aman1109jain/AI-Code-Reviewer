# Copy this file to .env and fill it in. NEVER commit .env (it is in .gitignore).

# ---------------------------------------------------------------- required
# Postgres connection string (Neon, or a local database).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Verify the database's TLS certificate (default). Use "off" only for a local database.
# DATABASE_SSL=verify

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# ---------------------------------------------------------------- GitHub webhook (REQUIRED for PR reviews)
# Without this, every incoming webhook is rejected. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# and paste the SAME value into GitHub -> repo Settings -> Webhooks -> "Secret"
# (Content type must be application/json, event: Pull requests).
GITHUB_WEBHOOK_SECRET=
WEBHOOK_PATH=/webhook/github
# Development only: forwards GitHub deliveries from smee.io to your laptop. Ignored in production.
SMEE_URL=

# ---------------------------------------------------------------- sessions & encryption
# 32+ random characters. REQUIRED in production. It encrypts the stored GitHub tokens and
# admin authenticator secrets. In development, if unset, one is generated in .data/session-secret.
# Changing it later makes existing stored tokens unreadable (users reconnect GitHub once and
# admins need their MFA reset), so choose it once and keep it safe.
# SESSION_SECRET=
# SESSION_DAYS=30
# ADMIN_IDLE_MINUTES=30
# ADMIN_MAX_HOURS=8

# ---------------------------------------------------------------- server / networking
PORT=3000
DASHBOARD_URL=http://localhost:5173
# Extra browser origins allowed to call the API (comma-separated). Usually not needed:
# requests from the app's own address are always accepted.
# ALLOWED_ORIGINS=https://reviews.example.com
# Number of reverse proxies in front of the app (e.g. 1 behind nginx/Render/Railway).
# Needed in production so rate limits see real client IPs. Do not use "true".
# TRUST_PROXY=1
# Serve the built dashboard from Express (default: on in production, off in development).
# SERVE_CLIENT=true
# Redirect http -> https (only if your proxy sets X-Forwarded-Proto correctly).
# FORCE_HTTPS=false
